# Copie para .env e preencha. O .env fica fora do git (tem senha).
# SMTP para o relatório por e-mail. No Gmail, use uma senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu.email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
# Remetente (opcional; padrão = SMTP_USER)
SMTP_FROM=
# Únicos e-mails que podem receber o relatório, separados por vírgula
RELATORIO_DESTINOS=pessoa1@exemplo.com,pessoa2@exemplo.com
